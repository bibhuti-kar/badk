#!/usr/bin/env python3
"""with-secrets KEYS SCRIPT [ARG ...]

Run tools/scripts/SCRIPT with the secrets named in KEYS (comma list, from tools/secrets.env)
added to its environment. Every secret value is masked in its stdout and stderr, so the
model, the trace and the DB never see it. badk passes only PATH, HOME and a few more
variables to tools; this is the one way a secret reaches a script.
"""

import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import toolkit_secrets as ts  # noqa: E402

if len(sys.argv) < 3:
    sys.exit(__doc__)
keys, script, args = sys.argv[1].split(","), sys.argv[2], sys.argv[3:]
if "/" in script or script.startswith("."):
    sys.exit(f"with-secrets: {script!r} must be a file name in tools/scripts")
secrets = ts.load()
missing = [k for k in keys if k not in secrets]
if missing:
    sys.exit(f"with-secrets: not in tools/secrets.env: {', '.join(missing)}")
env = {**os.environ, **{k: secrets[k] for k in keys}}
r = subprocess.run([str(ts.TOOLS / "scripts" / script), *args], env=env, capture_output=True, text=True)
sys.stdout.write(ts.redact(r.stdout, secrets))
sys.stderr.write(ts.redact(r.stderr, secrets))
sys.exit(r.returncode)
