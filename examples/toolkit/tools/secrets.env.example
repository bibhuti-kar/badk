# tools/secrets.env: secrets for the toolkit tools. KEY=VALUE, one per line. Keep it mode 600
# and out of git (scripts/init.sh does both). Reference a key as ${KEY} in mcp.json / apis.json,
# or name it in a with-secrets command. Delete the lines you do not use.
DEMO_TOKEN=change-me-demo-token

# Slack: bot token for apis.json "slack" (https://api.slack.com/apps -> OAuth & Permissions)
SLACK_BOT_TOKEN=
# Slack: user token for the slack MCP server (korotovsky/slack-mcp-server)
SLACK_MCP_XOXP_TOKEN=

# Telegram: bot token from @BotFather, for apis.json "telegram"
TELEGRAM_BOT_TOKEN=
# Telegram: user account, for the telegram MCP server (chigwell/telegram-mcp)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
# Telegram: folder of your telegram-mcp clone (git clone https://github.com/chigwell/telegram-mcp)

# Teams: incoming webhook URL (Teams channel -> Workflows -> "Post to a channel when a webhook request is received")
TEAMS_WEBHOOK_URL=

# Google: OAuth client (Google Cloud console -> APIs & Services -> Credentials -> Desktop app)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
TELEGRAM_MCP_DIR=
