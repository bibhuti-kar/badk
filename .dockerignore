# mirrors .gitignore. Unlike .gitignore, a pattern here matches from the context root only:
# `**/` makes it match at any depth (tools/secrets.env). Root lines stay for the parity probe.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
.envrc
**/.envrc
**/secrets.env*
!**/secrets.env.example
research/
graphify-out/
progress/
.wolf/
.venv/
**/.venv/
__pycache__/
**/__pycache__/
**/*.pyc
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
**/dist/
**/*.egg-info/
.idea/
.vscode/
**/.DS_Store
.review-state/
.guardrails.toml
.coverage
.coverage.*
.nt/

# build context needs pyproject, uv.lock, src (builder) and agents, tools (runtime stage)
.git/
.claude/
docs/
tests/
examples/
scripts/
docker/
docker-compose.yml
Makefile
README.md
CLAUDE.md
LICENSE
