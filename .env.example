# Copy to .env and substitute your own values. Never commit .env.
APP_PORT=8000
POSTGRES_USER=badk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=badk
POSTGRES_PORT=5432
RABBITMQ_DEFAULT_USER=badk
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_PORT=5672
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}
RABBITMQ_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@127.0.0.1:${RABBITMQ_PORT}/
TRACE_ENABLED=true
LOG_LEVEL=INFO
# openai = any OpenAI-compatible API (Ollama, DeepSeek); anthropic = Anthropic API with LLM_API_KEY; claude_cli = `claude -p` login.
LLM_PROVIDER=openai
LLM_MODEL=
# Local mode: the host process uses it. Cloud mode: the runtime container uses it, so it must be reachable from the container and not loopback (start.sh refuses it; e.g. http://host.docker.internal:11434, substitute your own). One .env per environment.
LLM_BASE_URL=http://127.0.0.1:11434
LLM_API_KEY=
# Used only by agent files that opt into claude_cli (model: $CLAUDE_MODEL).
CLAUDE_MODEL=
# Maximum reply tokens of one anthropic call. The anthropic SDK also reads ANTHROPIC_BASE_URL from the shell; badk check shows it.
LLM_MAX_TOKENS=16000
PROVIDER_TIMEOUT_SEC=120
# Cloud mode refuses claude_cli: use LLM_PROVIDER=openai or anthropic and no claude_cli agent (PROVIDER_OVERRIDE only accepts fake), else PROVIDER_NOT_ALLOWED.
CLOUD_DEPLOY=false
PROVIDER_OVERRIDE=
FAKE_SCRIPT=
